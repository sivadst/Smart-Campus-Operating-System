# ==============================================================================
# Smart Campus Operating System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your deployment environment.
# DO NOT commit the populated '.env' file containing real secrets to version control.

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcampus
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=jdbc:postgresql://localhost:5432/smartcampus

# PostgreSQL Connection Pool Settings (HikariCP)
DB_POOL_MIN_IDLE=5
DB_POOL_MAX_SIZE=20
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000

# ------------------------------------------------------------------------------
# 3. Redis Cache & Messaging Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. JWT & Security Configuration
# ------------------------------------------------------------------------------
# Minimum 256-bit hexadecimal key for HMAC-SHA256 signing
JWT_SECRET=4b2a8d1e9f3c7a6b5d8e4f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c

# Access token validity: 15 minutes (in milliseconds: 15 * 60 * 1000 = 900000)
JWT_EXPIRATION_MS=900000

# Refresh token validity: 7 days (in milliseconds: 7 * 24 * 60 * 60 * 1000 = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# Rate Limiting (Bucket4j / Filter tokens per minute per client IP)
RATE_LIMIT_PER_MINUTE=100

# ------------------------------------------------------------------------------
# 5. Spring Boot Actuator & Observability
# ------------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=when-authorized

# ------------------------------------------------------------------------------
# 6. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 7. Initial Super-Admin Bootstrap Credentials
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@smartcampus.edu
ADMIN_INITIAL_PASSWORD=Admin@123
